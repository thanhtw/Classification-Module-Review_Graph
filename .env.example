# Copy this file to .env and insert your private key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL_NAME=gpt-5.6-luna
OPENAI_LLM_MAX_TOKENS=512
OPENAI_LLM_REASONING_EFFORT=none

HF_MODEL_CACHE_DIR=.cache/huggingface/hub

TRAIN_RNN_EPOCHS=30
TRAIN_BERT_EPOCHS=30
TRAIN_ROBERTA_EPOCHS=30
TRAIN_ML_EPOCHS=30
TRAIN_RNN_LR=0.001
TRAIN_BERT_LR=0.00002
TRAIN_ROBERTA_LR=0.00002
